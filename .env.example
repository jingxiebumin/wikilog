NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# Local development only. Do not use these credentials in production.
DATABASE_URL=postgresql://wikilog:wikilog_local_only@127.0.0.1:5432/wikilog
AUTH_ENABLED=false
ARTICLE_STORAGE_DIR=/app/uploads/articles
ARTICLE_STORAGE_VERIFIED=false
# Integers: count 1-50, image bytes 1-26214400, total bytes 1-104857600.
# Invalid/out-of-range values use defaults: 10 images, 5 MiB each, 25 MiB total.
ARTICLE_IMAGE_MAX_COUNT=10
ARTICLE_IMAGE_MAX_BYTES=5242880
ARTICLE_IMAGE_MAX_TOTAL_BYTES=26214400

# Q&A stays disabled until the DeepSeek API data-processing policy is verified.
# Keep both flags false until the owner records that verification and approves activation.
ADMIN_QA_ENABLED=false
DEEPSEEK_DATA_POLICY_VERIFIED=false
DEEPSEEK_TEXT_MODELS=deepseek-chat
# DEEPSEEK_API_KEY=

# One-time manual administrator bootstrap. Do not keep these values after
# `npm run admin:init` succeeds.
# ADMIN_EMAIL=admin@example.com
# ADMIN_DISPLAY_NAME=管理员
# ADMIN_PASSWORD=replace-with-a-long-password
